# ==========================================
# Inspire 项目专属 .gitignore
# ==========================================

# 1. 数据集与模型权重 (绝对不能传，极其卡顿)
data/
ckpts/
Bench2Drive/inspire/
Bench2Drive/Bench2DriveZoo/
Bench2Drive/
carla/
assets/gifs/
test/
*.pth
*.pt
*.ckpt

# 2. 训练日志与运行时的输出
*.log
inspire_train.log
work_dirs/
outputs/
.dist_test/

# 3. Python 编译产物与包信息 (每次跑代码自动生成的)
build/
*.egg-info/
__pycache__/
*.pyc
*.so

# 4. IDE 配置文件与系统隐藏文件
.vscode/
.idea/
.DS_Store

# 5. 大型数据文件兜底 (防止不小心塞了几个G的缓存进去)
*.pkl
*.npy
*.npz
*.bin
*.tar
*.zip
